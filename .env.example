# DHARMA BOOKS PRO - PRODUCTION ENVIRONMENT CONFIGURATION

# Server Port and Host
PORT=3000
NODE_ENV=production

# Supabase Credentials (Database & Authentication)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Cloudflare R2 Object Storage (file/media uploads via /api/media/upload)
# Without these, uploads fall back to Supabase Storage, then to storing the
# file as a base64 string directly in the database — see src/lib/storage.ts.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-r2-bucket-name
R2_PUBLIC_URL=https://your-r2-public-bucket-url.example.com

# Cloudinary (optional — preferred file-upload provider when set; browser
# uploads directly to Cloudinary using an UNSIGNED upload preset, so only
# the public cloud name + preset name are needed here, no secret key).
# See the Cloudinary setup guide for how to get these two values.
VITE_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset-name

# Trusted proxy hops in front of the app when NOT on Netlify (0 = trust none;
# client IP then comes from the socket). On Netlify this is ignored: the
# platform-set x-nf-client-connection-ip header is used instead.
TRUSTED_PROXY_HOPS=0
# (ADMIN_MFA_TOTP_SECRET / JWT_SECRET were unused and have been removed.)
