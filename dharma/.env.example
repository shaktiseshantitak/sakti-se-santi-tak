# DHARMA BOOKS PRO - PRODUCTION ENVIRONMENT CONFIGURATION

# Server Port and Host
PORT=3000
NODE_ENV=production

# Supabase Credentials (Database & Authentication)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Cloudflare R2 Object Storage (file/media uploads via /api/media/upload)
# Without these, uploads fall back to Supabase Storage, then to storing the
# file as a base64 string directly in the database — see src/lib/storage.ts.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-r2-bucket-name
R2_PUBLIC_URL=https://your-r2-public-bucket-url.example.com

# Security Secrets
ADMIN_MFA_TOTP_SECRET=your-admin-mfa-totp-secret-key
JWT_SECRET=your-jwt-signing-secret
